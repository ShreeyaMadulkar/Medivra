# Copy to .env and fill in. Never commit .env.
PORT=5000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=medivra

# Required: random string of at least 32 characters
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1h

CLIENT_ORIGIN=http://localhost:5173

# Lockout demo settings (assignment: 3 attempts, 30 seconds)
MAX_FAILED_LOGINS=3
LOCKOUT_SECONDS=30

# Rate limiting (per IP)
LOGIN_RATE_LIMIT_MAX=20
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
REGISTER_RATE_LIMIT_MAX=20
REGISTER_RATE_LIMIT_WINDOW_SECONDS=3600

# true = new registrations start INACTIVE until an admin activates them (activation UI/API comes in a later phase)
REGISTRATION_REQUIRES_APPROVAL=false

# One-time admin seed (npm run seed:admin). Remove the password from .env afterwards.
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_PHONE=

# Tests use a separate database so your real data is never touched
TEST_DB_NAME=medivra_test
